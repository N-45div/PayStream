# LLM via OpenRouter (supports any model)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# WDK seed phrase (optional — auto-generated and persisted to .seed file if not set)
# Leave empty for auto-generation on first run
WDK_SEED=

# GitHub (for PR monitoring)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=owner/repo

# RPC URLs (free public endpoints, override with your own if needed)
POLYGON_RPC=https://polygon.llamarpc.com
ETH_RPC=https://eth.llamarpc.com
ARB_RPC=https://arbitrum.llamarpc.com
SOLANA_RPC=https://api.mainnet-beta.solana.com

# API Server
PORT=8000
